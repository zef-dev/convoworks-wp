<?xml version="1.0"?>
<ruleset name="Convoworks PHP 8.4 Compatibility Check">
    <description>Check for PHP 8.4 compatibility issues</description>

    <!-- Configure installed paths for PHPCompatibility -->
    <config name="installed_paths" value="vendor/phpcompatibility/php-compatibility"/>

    <!-- Scan the src directory -->
    <file>src</file>

    <!-- Exclude vendor directory -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <!-- Use PHPCompatibility ruleset -->
    <config name="testVersion" value="8.4"/>

    <!-- Include PHPCompatibility rules -->
    <rule ref="PHPCompatibility"/>

    <!-- Show progress -->
    <arg value="p"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
</ruleset>
