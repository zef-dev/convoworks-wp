{
	"name" : "convowp/convowp-plugin",
	"description" : "Convoworks WP is a GUI-based, cross-platform, voice assistant service development tool.",
	"keywords" : [
		"wordpress",
		"plugin",
		"marketing",
		"convoworks"
	],
	"license" : "MIT",
	"type" : "wordpress-plugin",
	"homepage" : "https://influendo.com",
	"authors" : [{
			"name" : "Influendo",
			"email" : "info@influendo.com",
			"homepage" : "https://influendo.com",
			"role" : "Developer"
		}
	],
	"repositories" : [ {
			"type" : "vcs",
			"url" : "https://codeforest@bitbucket.org/influendo/influendo-support.git"
		},
		{
            "type": "path",
            "url": "../*",
            "packagist.org": false,
            "options": {
                "symlink": true
            }
        }
	],
	"require" : {
		"php": ">=7.2.5",
		"guzzlehttp/guzzle": "~7.0",
		"influendo/influendo-support": "^1.0.8",
		"league/plates": "^3.3",
		"luchianenco/oauth2-amazon": "^1.1",
		"middlewares/cors": "^1.1",
		"middlewares/encoder": "^1.1",
		"middlewares/http-authentication": "^1.1",
		"middlewares/trailing-slash": "^1.1",
		"monolog/monolog": "^2.0.2",
		"nikic/php-parser": "~3.1",
		"psr/http-client": "^1.0.0",
		"psr/http-message": "^1.0.1",
		"psr/log": "^1.1.0",
		"symfony/dependency-injection": "^5.4",
		"symfony/service-contracts": "2.4.1",
		"guzzlehttp/psr7" : "^1.6",
		"http-interop/http-factory-guzzle" : "^1.0",
		"zef-dev/convoworks-core": "@dev",
		"zef-dev/zef-monolog-formatter": "^1.0"
	},
	"autoload" : {
		"psr-4" : {
			"Convo\\" : "src/Convo",
			"Convo\\Wp\\" : "src/Convo/Wp/",
			"Convo\\Data\\Wp\\" : "src/Convo/Data/Wp/",
			"Inpsyde\\WPRESTStarter\\" : "wp-rest-starter/Inpsyde/WPRESTStarter"
		},
		"files" : [
			"src/Convo/helpers.php"
		]
	},
	"config" : {
		"platform": {
			"php": "7.2.5"
		},
		"preferred-install" : "dist",
		"sort-packages" : true
	}
}
