{
	"name" : "convowp/convowp-plugin",
	"description" : "ConvoworksWP plugin",
	"keywords" : [
		"wordpress",
		"plugin",
		"marketing",
		"convoworks"
	],
	"license" : "MIT",
	"type" : "wordpress-plugin",
	"homepage" : "https://influendo.com",
	"authors" : [{
			"name" : "Influendo",
			"email" : "info@influendo.com",
			"homepage" : "https://influendo.com",
			"role" : "Developer"
		}
	],
	"repositories" : [ {
			"type" : "vcs",
			"url" : "https://codeforest@bitbucket.org/influendo/influendo-support.git"
		}
	],
	"require" : {
		"php" : ">=7.2.0",
		"guzzlehttp/guzzle" : "~6.0",
		"psr/log" : "^1.1.0",
		"psr/http-client" : "^1.0.0",
		"psr/http-message" : "^1.0.1",
		"php-di/php-di" : "^6.0",
		"monolog/monolog" : "^2.0.2",
		"middlewares/cors" : "^1.1",
		"middlewares/trailing-slash" : "^1.1",
		"middlewares/http-authentication" : "^1.1",
		"middlewares/encoder" : "^1.1",
		"zef-dev/zef-monolog-formatter" : "^1.0",
        "zef-dev/convoworks-core" : "^0.20.0",
        "zef-dev/convoworks-data-filesystem" : "^1.1.3",
        "zef-dev/convoworks-guzzle" : "^1.0.3",
        "zef-dev/convoworks-pckg-mysqli" : "^1.0.3",
        "zef-dev/convoworks-pckg-trivia" : "^1.0.3",
        "zef-dev/convoworks-pckg-filesystem" : "^1.0.4",
		"inpsyde/wp-rest-starter" : "^4.0",
		"league/plates" : "^3.3",
		"luchianenco/oauth2-amazon" : "^1.1",
		"nikic/php-parser" : "~3.1",
		"influendo/influendo-support" : "^1.0.8"
	},
	"autoload" : {
		"psr-4" : {
			"ConvoPlugin\\" : "src/",
			"Convo\\Wp\\" : "src/Convo/Wp/"
		},
		"files" : [
			"src/helpers.php"
		]
	},
	"config" : {
		"preferred-install" : "dist",
		"sort-packages" : true
	}
}